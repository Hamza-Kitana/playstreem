{
  "manifest_version": 3,
  "name": "Al-Daboor TikTok Bridge",
  "description": "Sends TikTok LIVE comments and gifts to Al-Daboor stream games.",
  "version": "1.0.0",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "Al-Daboor TikTok",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.vercel.app/*"],
      "js": ["site.js"],
      "run_at": "document_start"
    }
  ]
}
